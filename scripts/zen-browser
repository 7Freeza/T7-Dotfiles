#!/usr/bin/env bash
# Launch Zen (Hyprland-safe). Niri-specific edge fix removed.
set -euo pipefail

if pgrep -x zen-bin >/dev/null 2>&1; then
  # Focus existing window if possible
  if command -v hyprctl >/dev/null 2>&1; then
    addr=$(hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json
try:
    clients = json.load(sys.stdin)
except Exception:
    raise SystemExit
for c in clients:
    cls = (c.get('class') or '') + ' ' + (c.get('initialClass') or '')
    if 'zen' in cls.lower():
        print(c.get('address',''))
        break
" 2>/dev/null || true)
    if [[ -n "${addr:-}" ]]; then
      hyprctl dispatch focuswindow "address:${addr}" >/dev/null 2>&1 || true
      exit 0
    fi
  fi
fi

exec /usr/bin/zen-browser "$@"
