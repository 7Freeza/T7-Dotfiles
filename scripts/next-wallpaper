#!/usr/bin/env bash
# Cycle wallpaper via Noctalia IPC only. Never reloads compositor / never kills shell.
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/settings.json"
DIR="${NOCTALIA_WALLPAPER_DIR:-}"

if [[ -z "$DIR" && -f "$SETTINGS" ]]; then
  DIR=$(python3 - <<'PY' 2>/dev/null || true
import json
from pathlib import Path
try:
    print(json.loads(Path.home().joinpath(".config/noctalia/settings.json").read_text())["wallpaper"]["directory"])
except Exception:
    pass
PY
)
fi
DIR="${DIR:-$HOME/Wallpapers}"

if ! command -v qs >/dev/null 2>&1; then
  echo "qs not found" >&2
  exit 1
fi

current=$(qs -c noctalia-shell ipc call wallpaper get 2>/dev/null || true)

mapfile -t files < <(
  find -L "$DIR" -maxdepth 1 -type f \( \
    -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
    -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.gif' \
  \) -printf '%f\t%p\n' 2>/dev/null | LC_ALL=C sort -r -t $'\t' -k1,1 | cut -f2-
)

if ((${#files[@]} == 0)); then
  echo "No wallpapers in $DIR" >&2
  exit 1
fi

idx=-1
for i in "${!files[@]}"; do
  if [[ "${files[$i]}" == "$current" ]]; then
    idx=$i
    break
  fi
done

next=$(( (idx + 1) % ${#files[@]} ))
qs -c noctalia-shell ipc call wallpaper set "${files[$next]}" 2>/dev/null || exit 1
exit 0
