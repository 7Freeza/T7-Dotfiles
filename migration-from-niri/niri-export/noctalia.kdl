layout {

    focus-ring {
        active-color   "#c9c7b7"
        inactive-color "#141312"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c9c7b7"
        inactive-color "#141312"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c9c7b7"
        inactive-color "#48473b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c9c7b780"
    }
}

recent-windows {
    highlight {
        active-color "#c9c7b7"
        urgent-color "#ffb4ab"
    }
}
