{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": { "type": "none" },

  "modules": [
    { "type": "custom", "format": "╭───────────────────────────╮" },
    { "type": "os",       "key": "  OS",       "format": "{2}", "keyColor": "38;2;{{colors.surface_variant.default.red}};{{colors.surface_variant.default.green}};{{colors.surface_variant.default.blue}}" },
    { "type": "kernel",   "key": "  Kernel",   "format": "{2}", "keyColor": "38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}" },
    { "type": "shell",    "key": "  Shell",    "keyColor": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}" },
    { "type": "wm",       "key": "  WM",       "format": "{2}", "keyColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}" },
    { "type": "uptime",   "key": "  Uptime",   "keyColor": "38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}" },
    { "type": "custom", "format": "╰───────────────────────────╯" }
  ]
}