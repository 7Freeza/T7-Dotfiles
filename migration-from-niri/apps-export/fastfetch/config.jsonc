{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": { "type": "none" },

  "modules": [
    { "type": "custom", "format": "╭───────────────────────────╮" },
    { "type": "os",       "key": "  OS",       "format": "{2}", "keyColor": "38;2;72;71;63" },
    { "type": "kernel",   "key": "  Kernel",   "format": "{2}", "keyColor": "38;2;147;145;135" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;2;201;199;183" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "38;2;201;198;190" },
    { "type": "shell",    "key": "  Shell",    "keyColor": "38;2;193;201;191" },
    { "type": "wm",       "key": "  WM",       "format": "{2}", "keyColor": "38;2;201;199;183" },
    { "type": "uptime",   "key": "  Uptime",   "keyColor": "38;2;147;145;135" },
    { "type": "custom", "format": "╰───────────────────────────╯" }
  ]
}