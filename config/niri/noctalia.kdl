// SAMPLE — regenerated by Noctalia from wallpaper colors.
layout {

    focus-ring {
        active-color   "#ffb963"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb963"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb963"
        inactive-color "#663e00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb96380"
    }
}

recent-windows {
    highlight {
        active-color "#ffb963"
        urgent-color "#ffb4ab"
    }
}
