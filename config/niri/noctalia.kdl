// SAMPLE — regenerated by Noctalia from wallpaper colors. Safe to overwrite.
layout {

    focus-ring {
        active-color   "#cbb9bf"
        inactive-color "#211c1e"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#cbb9bf"
        inactive-color "#211c1e"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#211c1e70"
    }

    tab-indicator {
        active-color   "#cbb9bf"
        inactive-color "#785964"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#cbb9bf80"
    }
}

recent-windows {
    highlight {
        active-color "#cbb9bf"
        urgent-color "#fd4663"
    }
}
