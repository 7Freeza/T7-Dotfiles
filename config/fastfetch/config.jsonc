{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": { "type": "none" },

  "modules": [
    { "type": "custom", "format": "╭───────────────────────────╮" },
    { "type": "os",       "key": "  OS",       "format": "{2}", "keyColor": "38;2;71;71;71" },
    { "type": "kernel",   "key": "  Kernel",   "format": "{2}", "keyColor": "38;2;145;145;145" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;2;255;185;99" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "38;2;223;193;162" },
    { "type": "shell",    "key": "  Shell",    "keyColor": "38;2;188;205;157" },
    { "type": "wm",       "key": "  WM",       "format": "{2}", "keyColor": "38;2;255;185;99" },
    { "type": "uptime",   "key": "  Uptime",   "keyColor": "38;2;145;145;145" },
    { "type": "custom", "format": "╰───────────────────────────╯" }
  ]
}