{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": { "type": "none" },

  "modules": [
    { "type": "custom", "format": "╭───────────────────────────╮" },
    { "type": "os",       "key": "  OS",       "format": "{2}", "keyColor": "38;2;83;67;66" },
    { "type": "kernel",   "key": "  Kernel",   "format": "{2}", "keyColor": "38;2;160;140;139" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;2;255;179;176" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "38;2;231;189;186" },
    { "type": "shell",    "key": "  Shell",    "keyColor": "38;2;227;194;140" },
    { "type": "wm",       "key": "  WM",       "format": "{2}", "keyColor": "38;2;255;179;176" },
    { "type": "uptime",   "key": "  Uptime",   "keyColor": "38;2;160;140;139" },
    { "type": "custom", "format": "╰───────────────────────────╯" }
  ]
}