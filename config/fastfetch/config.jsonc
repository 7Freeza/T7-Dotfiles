{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": { "type": "none" },

  "modules": [
    { "type": "custom", "format": "╭───────────────────────────╮" },
    { "type": "os",       "key": "  OS",       "format": "{2}", "keyColor": "38;2;44;38;40" },
    { "type": "kernel",   "key": "  Kernel",   "format": "{2}", "keyColor": "38;2;111;102;104" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;2;203;185;191" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "38;2;201;187;188" },
    { "type": "shell",    "key": "  Shell",    "keyColor": "38;2;200;190;188" },
    { "type": "wm",       "key": "  WM",       "format": "{2}", "keyColor": "38;2;203;185;191" },
    { "type": "uptime",   "key": "  Uptime",   "keyColor": "38;2;111;102;104" },
    { "type": "custom", "format": "╰───────────────────────────╯" }
  ]
}